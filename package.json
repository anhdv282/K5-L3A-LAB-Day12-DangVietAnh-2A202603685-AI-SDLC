{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng – game 3D (three.js) + headless theo Test Contract v1.0",
  "scripts": {
    "start": "node server.js",
    "headless": "node src/headless.js",
    "test": "node --test --test-reporter=spec tests/",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc --jitless --max-semi-space-size=1 scripts/soak.mjs --seed 7 --nights 10 --out soak.json"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "license": "MIT"
}
